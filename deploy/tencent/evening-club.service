[Unit]
Description=Evening Club multiplayer arcade
After=network.target
[Service]
Type=simple
User=eveningclub
Group=eveningclub
WorkingDirectory=/opt/evening-club/current
Environment=PATH=/opt/evening-club/node/bin:/usr/local/bin:/usr/bin:/bin
Environment=DATA_DIR=/opt/evening-club/shared/data
Environment=TRUSTED_PROXY_HOPS=1
ExecStart=/opt/evening-club/current/.venv/bin/python start.py --bind 127.0.0.1 --port 10000
Restart=always
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/evening-club/shared/data
MemoryMax=2G
TasksMax=128
UMask=0027
SyslogIdentifier=evening-club
[Install]
WantedBy=multi-user.target
